BASE_URL=http://localhost:8000
API_PREFIX=/api/v1
# ถ้ารันแบบ ASGI in-process (ไม่ต้อง start server) ให้เว้น BASE_URL ว่างไว้ แล้ว test จะใช้ ASGITransport
# BASE_URL=

# Test users (จะสร้างแบบสุ่มถ้าไม่กำหนด)
TEST_USER_EMAIL=automate_test_user@example.com
TEST_USER_PASSWORD=Test1234!@#
TEST_ADMIN_EMAIL=admin@scamguard.local
TEST_ADMIN_PASSWORD=Admin1234!@#

# DB / Redis (ใช้ของ server/.env ถ้าไม่กำหนดที่นี่)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/scamguard
# REDIS_URL=redis://localhost:6379/0

# Report
REPORT_TITLE=ScamGuard Automate Test Report
