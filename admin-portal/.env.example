# ==============================================================================
# ScamGuard Admin Forensics Portal - Environment Template (.env.example)
# ==============================================================================
# คำแนะนำการใช้งาน:
# 1. คัดลอกไฟล์นี้ไปเป็น .env สำหรับใช้งานในเครื่องของคุณ:
#    cp .env.example .env
# 2. แก้ไขหรือระบุค่าคอนฟิกให้ตรงกับสภาพแวดล้อมการทำงาน
# 3. ตัวแปรทั้งหมดที่เรียกใช้บน Client-side ของ Vite จะต้องขึ้นต้นด้วย VITE_ เสมอ


# ------------------------------------------------------------------------------
# 1. Application & Environment Info
# ------------------------------------------------------------------------------
# ชื่อแอปพลิเคชันที่แสดงบนแถบหัวเรื่องและส่วนหัวของระบบ
VITE_APP_NAME="ScamGuard Cyber-Forensics Console"

# สภาพแวดล้อมการทำงาน: development | staging | production
VITE_APP_ENV=development

# เวอร์ชันของระบบ
VITE_APP_VERSION=1.0.0

# ------------------------------------------------------------------------------
# 2. Backend API & Server Proxy
# ------------------------------------------------------------------------------
# ปลายทางของ FastAPI Backend สำหรับ Vite Dev Proxy (Forward คำขอเพื่อเลี่ยง CORS ใน Dev)
VITE_BACKEND_TARGET=http://127.0.0.1:8000

# เส้นทางหลักของ API (ใน Dev แนะนำให้ใช้ /api/v1 เพื่อส่งผ่าน Proxy)
# ใน Production ให้กำหนดเป็น URL เต็ม เช่น https://api.scamguard.ai/api/v1
VITE_API_BASE_URL=/api/v1

# ------------------------------------------------------------------------------
# 3. Live Telemetry & WebSockets
# ------------------------------------------------------------------------------
# WebSocket URL สำหรับการสตรีมข้อมูลสถิติสดและคิวสืบสวน
# หากเว้นว่างไว้ ระบบจะคำนวณจากโฮสต์ปัจจุบันอัตโนมัติ (${protocol}//${host}/api/v1/ws)
# หรือกำหนดเฉพาะเจาะจง เช่น ws://127.0.0.1:8000/api/v1/ws
VITE_WS_URL=

# ------------------------------------------------------------------------------
# 4. Storage & Media Asset Service
# ------------------------------------------------------------------------------
# เส้นทางสำหรับดาวน์โหลดและเปิดดูไฟล์ภาพหลักฐาน ภาพสแกน และผลลัพธ์ Heatmap
VITE_STORAGE_URL=/uploads

# ------------------------------------------------------------------------------
# 5. Security & Session Policies
# ------------------------------------------------------------------------------
# ระยะเวลาสำรอง (วินาที) สำหรับการ Silent Refresh โทเค็นก่อนที่ Access Token จะหมดอายุ
VITE_REFRESH_LEEWAY_SECONDS=10

# กำหนดระยะเวลาแจ้งเตือนเซสชันหมดอายุ (หน่วย: นาที)
VITE_SESSION_TIMEOUT_MINUTES=60

# บังคับบันทึก Audit Log ทุกการกระทำของผู้ดูแลระบบ (true / false)
VITE_ENABLE_AUDIT_LOGGING=true

# บังคับเชื่อมต่อ Real Backend เท่านั้น ไม่อนุญาตให้ใช้ Mock Data (true / false)
VITE_ENABLE_MOCK_FALLBACK=false

# ------------------------------------------------------------------------------
# 6. Development Quick Access (ข้อมูลประจำตัวเริ่มต้นสำหรับโหมดพัฒนา)
# ------------------------------------------------------------------------------
# ตัวแปรสำหรับกรอกข้อมูลบัญชีผู้ดูแลระบบลงในแบบฟอร์มหน้าเข้าสู่ระบบอัตโนมัติ (Login Pre-fill)
# มีผลเฉพาะในโหมดพัฒนา (development) เท่านั้น เพื่อความสะดวกและรวดเร็วในการทดสอบระบบ
#
# ค่าเริ่มต้นที่ใช้ทดสอบกับ Local Backend:
# - บัญชี Super Admin: admin@gmail.local (สร้างโดย server/scripts/admin.sh)
# - รหัสผ่านเริ่มต้นสำหรับทดสอบในเครื่อง: password123
#
# คำเตือน: ในไฟล์ .env.example นี้จะเว้นว่างรหัสผ่านไว้เพื่อความปลอดภัย
# กรุณาระบุรหัสผ่านในไฟล์ .env ของเครื่องคุณเอง
VITE_DEFAULT_ADMIN_USERNAME=admin@gmail.local
VITE_DEFAULT_ADMIN_PASSWORD=
